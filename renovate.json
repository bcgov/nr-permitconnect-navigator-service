{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bcgov/renovate-config#2026.10.29"
  ],
  "automerge": true,
  "branchPrefix": "chore/",
  "dependencyDashboard": {
    "enabled": true
  },
  "draftPR": false,
  "minimumReleaseAge": "3 days",
  "mode": "full",
  "packageRules": [
    {
      "description": "v5+ is GPL-3.0; 4.4.5 is MIT",
      "matchPackageNames": ["iframe-resizer"],
      "enabled": false
    }
  ],
  "prConcurrentLimit": 3,
  "pruneStaleBranches": true,
  "rangeStrategy": "pin",
  "schedule": [
    "* * * * 2"
  ],
  "timezone": "America/Vancouver"
}
